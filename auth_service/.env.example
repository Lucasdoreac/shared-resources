# Configuração do login por link mágico (auth_service). Guia: ../docs/CONFIGURACAO.md.
# O teste tests/test_env_example.py garante que este arquivo lista exatamente o que o código lê.
FLASK_ENV=development
# true = devolve o link de login na resposta HTTP, sem e-mail (só vale com FLASK_ENV=development).
# Deixa qualquer um entrar como qualquer @udf.edu.br: NUNCA em produção. Padrão: false.
AUTH_DEV_RETURN_LINK=false
# endereço público do frontend do Reservas: base do link de login
REACT_APP=http://localhost:3000
# MongoDB: MONGO_URI OU o trio HOST/USERNAME/PASSWORD (Atlas, mongodb+srv)
MONGO_URI=mongodb://localhost:27017/
MONGO_HOST=
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DATABASE=rooms-reservation-app
# cache dos tokens de login (RedisCache ou SimpleCache em memoria)
CACHE_TYPE=RedisCache
# sem ela o serviço tenta redis://localhost:6379/0 quando CACHE_TYPE=RedisCache
REDIS_URL=redis://localhost:6379/0
# Cloud Function que entrega o e-mail com o link (produção)
CLOUD_FUNCTION_URL=
CLOUD_FUNCTION_API_KEY=
# endereço público do MinIO, com esquema: ícone do e-mail de login
MINIO_URL=http://localhost:9000
