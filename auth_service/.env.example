REACT_APP=http://localhost:3000
MONGO_DATABASE=rooms-reservation-app
MONGO_HOST=dwcorp.y5ugild.mongodb.net
MONGO_DATABASE=rooms-reservation-app
MONGO_USERNAME=
MONGO_PASSWORD=
CLOUD_FUNCTION_URL=
CLOUD_FUNCTION_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Reservas UDF
AUTH_EMAIL_ALLOWLIST=
EMAIL_DRY_RUN=false
FLASK_ENV=development
MINIO_URL=http://dwcorp.com.br:9000
# validade do link enviado por e-mail, em minutos (padrao 30); o link vale uma vez
AUTH_LINK_TTL_MINUTES=30
# validade da sessao que o link troca, em minutos (padrao 720)
AUTH_SESSION_TTL_MINUTES=720
# janela, em segundos, dos limites de send-link e validate (padrao 900)
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# proxies que acrescentam X-Forwarded-For antes do servico (padrao 1)
TRUSTED_PROXY_HOPS=1
# true = serve /apidocs e /apispec_1.json (fechado por padrao)
ENABLE_API_DOCS=false
# so em desenvolvimento (FLASK_ENV=development): reabre os padroes fechados (docs)
ALLOW_INSECURE_DEV=false
# true = devolve o link de login na resposta HTTP, sem e-mail (so vale com FLASK_ENV=development; NUNCA em producao)
AUTH_DEV_RETURN_LINK=false
# origem do frontend aceita pelo CORS (alem de REACT_APP); opcional, separadas por virgula
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
# nome antigo de AUTH_EMAIL_ALLOWLIST (Production); so e lido quando o novo nao esta definido
AUTH_ALLOWED_EMAILS=
