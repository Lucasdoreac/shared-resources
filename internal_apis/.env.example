# Configuração do catálogo (internal_apis). Guia: ../docs/CONFIGURACAO.md.
# O teste src/Tests/test_env_example.py garante que este arquivo lista exatamente o que o código lê.
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=rooms-reservation-app
# chaves aceitas no header x-api-key, separadas por vírgula (exigido em /restapi e /graphql)
API_KEY_LIST=
# cache (Flask-Caching); sem ela o serviço tenta redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
# opcional: host público; vazio = aceita qualquer Host
SERVER_NAME=
