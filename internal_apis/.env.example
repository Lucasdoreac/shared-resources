MONGO_URI=
MONGO_DATABASE=
# chaves aceitas em x-api-key, separadas por virgula; vazia ou ausente impede o inicio
API_KEY_LIST=
SERVER_NAME=
# so em desenvolvimento (FLASK_ENV=development): permite iniciar sem chaves e deixa o catalogo aberto
ALLOW_INSECURE_DEV=false
# true = serve /apidocs e /apispec.json (fechado por padrao)
ENABLE_API_DOCS=false
